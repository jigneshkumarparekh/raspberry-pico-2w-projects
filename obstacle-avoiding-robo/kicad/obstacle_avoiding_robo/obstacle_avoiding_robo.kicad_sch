  (text "Pico 2 W is removable: install J1/J2 as 1x20 female socket headers matching the module orientation." (at 20.32 148.00 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "6ba863e0-d099-5f71-bcad-10563ae17226")
  )
  (text "TB6612FNG breakout pin order must match J3/J4 exactly before PCB layout or manufacturing." (at 20.32 153.08 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "4a5b8222-94cd-56aa-a805-364a8193a8d6")
  )
  (text "J3 pin order: VM, VCC, GND, AO1, AO2, BO2, BO1, GND." (at 20.32 158.16 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "ddfa3044-d71e-5b03-aace-491ea0ef115a")
  )
  (text "J4 pin order: PWMA, AIN2, AIN1, STBY, BIN1, BIN2, PWMB, GND." (at 20.32 163.24 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "2917148b-01fd-53db-978f-c1c0ed222329")
  )
  (text "Battery positive feeds Pico VSYS and TB6612FNG VM. Pico 3V3 feeds TB6612FNG VCC and ultrasonic VCC." (at 20.32 168.32 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "28bdd5b9-4de0-5740-b0d9-e5efb6cc79da")
  )
  (text "Common ground is required across Pico, TB6612FNG, motors supply return, battery negative, and ultrasonic sensor." (at 20.32 173.40 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "03182e0e-2e55-5ffd-bc0e-842cb1678616")
  )
  (text "Use a 3.3 V-safe ultrasonic sensor, or level-shift/divide ECHO before GPIO17 if the sensor is powered from 5 V." (at 20.32 178.48 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "8054cc84-38bd-545f-873a-843d6144b6b3")
  )
